# ARVOX Finance — environment template. Copy to .env.local (never commit secrets).
# Only NEXT_PUBLIC_* is safe for browsers. DATABASE_URL stays server-only.

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
RPC_URL=
MARKET_DATA_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/arvox

# Server-only waitlist endpoint (client calls this URL, never the DB directly)
WAITLIST_API_URL=/api/waitlist
